#pragma kernel buildTriangle
#pragma kernel calculateFlow
#pragma kernel calculateHeight
#pragma kernel updatePos

int _resolution;
float _step;
float _offset;
float _dt;

float _pipeLength;
float _gravity;
float _pipeArea;
float _density;
float _damping;

RWStructuredBuffer<int> _triangles;
RWStructuredBuffer<float3> _position;
RWStructuredBuffer<float> _height;
RWStructuredBuffer<float> _extPressure;
RWStructuredBuffer<float> _volume;
RWStructuredBuffer<float> _flows;

[numthreads(8, 8, 1)]
void buildTriangle(uint3 id : SV_DispatchThreadID)
{
    if (id.x < (uint)_resolution - 1 && id.y < (uint)_resolution - 1)
    {
        int vertIdx = (id.y * _resolution) + id.x;
        int quardIdx = ((id.y * (_resolution - 1)) + id.x) * 6;
        
        int topRight = vertIdx + 1;
        int bottomLeft = vertIdx + _resolution;
        int bottomRight = vertIdx + _resolution + 1;
        
        // Swapped vertex indices to reverse winding order
        // Triangle 1
        _triangles[quardIdx] = vertIdx;
        _triangles[quardIdx + 1] = bottomLeft;
        _triangles[quardIdx + 2] = topRight;

        // Triangle 2
        _triangles[quardIdx + 3] = bottomRight;
        _triangles[quardIdx + 4] = topRight;
        _triangles[quardIdx + 5] = bottomLeft;
    }
}

[numthreads(8, 8, 1)]
void calculateFlow(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_resolution || id.y >= (uint)_resolution) return;

    int idx = id.y * _resolution + id.x;
    float currentHeight = _height[idx];
    float currentPressure = _extPressure[idx];

//pipe layout
    int2 neighbors[8] = { 
        int2(-1, 0),  // 0: Left
        int2(1, 0),   // 1: Right
        int2(0, -1),  // 2: Down
        int2(0, 1),   // 3: Up
        int2(-1, -1), // 4: Bottom-Left
        int2(1, 1),   // 5: Top-Right
        int2(1, -1),  // 6: Bottom-Right
        int2(-1, 1)   // 7: Top-Left
    };
    
    for (int i = 0; i < 8; i++)
    {
        int nx = id.x + neighbors[i].x;
        int ny = id.y + neighbors[i].y;
        int flowIdx = idx * 8 + i;
        
        if (nx >= 0 && nx < _resolution && ny >= 0 && ny < _resolution)
        {
            int nIdx = ny * _resolution + nx;
            
            float neighborHeight = _height[nIdx];
            float neighborPressure = _extPressure[nIdx];
            
            // Calculate pressure difference
            float hDiff = currentHeight - neighborHeight;
            float pDiff = (_density * _gravity * hDiff) + (currentPressure - neighborPressure);
            
            // Diagonal pipes have sqrt(2) * pipeLength distance (~1.4142)
            float effectiveLength = (i >= 4) ? (_pipeLength * 1.41421356f) : _pipeLength;
            
            // Acceleration = (A * dP) / (rho * L)
            float acc = (_pipeArea * pDiff) / (_density * effectiveLength);
            
            // Apply acceleration & damping
            float newFlow = (_flows[flowIdx] + acc * _dt) * _damping;
            
            // Virtual pipes only allow non-negative outward flow
            _flows[flowIdx] = max(0.0f, newFlow);
        }
        else
        {
            // Boundary reflection (no flow through edges)
            _flows[flowIdx] = 0.0f;
        }
    }
}

[numthreads(8, 8, 1)]
void calculateHeight(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_resolution || id.y >= (uint)_resolution) return;

    int idx = id.y * _resolution + id.x;
    float totalFlowOut = 0.0f;
    float totalFlowIn = 0.0f;

    int2 neighbors[8] = { 
        int2(-1, 0),  // 0: Left
        int2(1, 0),   // 1: Right
        int2(0, -1),  // 2: Down
        int2(0, 1),   // 3: Up
        int2(-1, -1), // 4: Bottom-Left
        int2(1, 1),   // 5: Top-Right
        int2(1, -1),  // 6: Bottom-Right
        int2(-1, 1)   // 7: Top-Left
    };
    
    // Sum total outward flow from this cell across all 8 pipes
    for (int i = 0; i < 8; i++)
    {
        totalFlowOut += _flows[idx * 8 + i];
    }

    // Scale outward flow if total output exceeds available cell volume (Outflow Clamping)
    float availableVol = _volume[idx];
    float maxOutflow = totalFlowOut * _dt;
    float scale = (maxOutflow > availableVol && maxOutflow > 0.00001f) ? (availableVol / maxOutflow) : 1.0f;

    // Sum incoming flows from valid neighbor opposite pipes
    for (int i = 0; i < 8; i++)
    {
        int nx = id.x + neighbors[i].x;
        int ny = id.y + neighbors[i].y;
        
        if (nx >= 0 && nx < _resolution && ny >= 0 && ny < _resolution)
        {
            int nIdx = ny * _resolution + nx;
            
            // Bitwise XOR (i ^ 1) pairs opposite directions: 0<->1, 2<->3, 4<->5, 6<->7
            int oppositeDir = i ^ 1; 
            totalFlowIn += _flows[nIdx * 8 + oppositeDir];
        }
    }

    // Update volume based on net flow
    float netFlow = totalFlowIn - (totalFlowOut * scale);
    float vol = availableVol + (netFlow * _dt);
    
    // Prevent negative volume
    if (vol < 0.0f) vol = 0.0f;
    _volume[idx] = vol;
    
    // Update surface height
    _height[idx] = vol / (_pipeLength * _pipeLength);
}

[numthreads(8, 8, 1)]
void updatePos(uint3 id : SV_DispatchThreadID)
{
    if (id.x < (uint)_resolution && id.y < (uint)_resolution)
    {
        int idx = (id.y * _resolution) + id.x;
        
        float xPos = (id.x * _step) - _offset;
        float zPos = (id.y * _step) - _offset;
        
        // Standard GPU XZ layout: Y is height (faces UP naturally)
        _position[idx] = float3(xPos, _height[idx], zPos);
    }
}